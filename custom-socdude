#!/usr/bin/env python3
"""Thin launcher installed by Wazuh's <integration> hook.

The real SOCDude package lives at /opt/socdude/socdude so it can be
upgraded independently of this launcher, and so application code isn't
duplicated inside /var/ossec (which is Wazuh-managed territory).

NOTE ON THE INTEGRATION NAME: wazuh-integratord only accepts a fixed
list of "known" integration names (slack, pagerduty, virustotal,
shuffle, ...). Anything else is rejected UNLESS it starts with the
"custom-" prefix, which is Wazuh's mechanism for user-defined scripts.
That's why this file is named custom-socdude and referenced as
<name>custom-socdude</name> in ossec.conf, even though the project
itself is called "SOCDude". Renaming it to just "socdude" makes
wazuh-integratord silently reject it. Don't rename it.
"""

import sys

sys.path.insert(0, "/opt/socdude")

try:
    from socdude.cli import main
except ImportError as exc:  # pragma: no cover
    import logging
    logging.basicConfig(
        filename="/var/ossec/logs/integrations.log",
        level=logging.ERROR,
        format="%(asctime)s [custom-socdude] %(message)s",
    )
    logging.error("Could not import the socdude package from /opt/socdude: %s. Re-run install.sh.", exc)
    sys.exit(1)

if __name__ == "__main__":
    main(sys.argv)
